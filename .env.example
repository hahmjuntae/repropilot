# Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Replay the bundled example with scripted model responses; tests still run for real
MOCK_LLM=1

# Model overrides; defaults are listed in src/agent/models.ts
REPRO_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
REPRO_MODEL_REASON=nvidia/Nemotron-3.5-Super-VL
REPRO_MODEL_ESCALATE=nvidia/Nemotron-3-Ultra-550b-a55b

# Test runner: local | docker | nebius
REPRO_RUNNER=local
REPRO_INSTALL_DEPS=0
PYTHON_BIN=

# Nebius Sandboxes runner
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_IMAGE=
NEBIUS_SANDBOXES_URL=https://api.tokenfactory.nebius.com/sandboxes/v1

# Optional
TAVILY_API_KEY=
GITHUB_TOKEN=
REPRO_DOCKER_IMAGE=python:3.12-slim
REPRO_KEEP_WORKSPACE=0
