# Copy to .env.local and fill in. Never commit real values.

# --- Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# 1 replays the bundled example with scripted model responses (tests still run for real).
# Set to 0 once NEBIUS_API_KEY is set to call Nemotron.
MOCK_LLM=1

# --- Models (defaults in src/agent/models.ts; check with: npm run check:nebius -- models) ---
# Lightning and Super are listed in the Token Factory deprecation notice of November 2026.
REPRO_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
REPRO_MODEL_REASON=nvidia/Nemotron-3.5-Super-VL
# Not confirmed in the public docs. If the catalog does not have it, the last patch attempt falls back to REPRO_MODEL_REASON.
REPRO_MODEL_ESCALATE=nvidia/Nemotron-3-Ultra-550b-a55b
# 0 disables response_format=json_object for models without JSON mode (requests also retry without it on HTTP 400).
REPRO_JSON_MODE=1

# --- Test runner: local | docker | nebius ---
REPRO_RUNNER=local
REPRO_INSTALL_DEPS=0
PYTHON_BIN=

# --- Nebius Token Factory Sandboxes (REPRO_RUNNER=nebius) ---
# Project ID: Token Factory > Project settings, shown under the project name.
NEBIUS_PROJECT_ID=
# An image UUID or tag:NAME with python. Find one with: npm run check:nebius -- images
# or import python:3.12-slim with: npm run check:nebius -- import-python
NEBIUS_SANDBOX_IMAGE=
NEBIUS_SANDBOXES_URL=https://api.tokenfactory.nebius.com/sandboxes/v1

# --- Optional ---
TAVILY_API_KEY=
GITHUB_TOKEN=
REPRO_DOCKER_IMAGE=python:3.12-slim
REPRO_KEEP_WORKSPACE=0
