{
  "name": "repropilot",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a GitHub bug report into an execution-verified failing test and patch, powered by NVIDIA Nemotron on Nebius Token Factory.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "repro": "tsx scripts/repro.ts",
    "setup:python": "sh scripts/setup-python.sh",
    "build:demo": "DEMO_EXPORT=1 next build",
    "record:replay": "tsx scripts/record-replay.ts",
    "deploy:demo": "npm run build:demo && wrangler deploy",
    "check:nebius": "tsx scripts/check-nebius.ts"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "next": "^16.4.3",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
